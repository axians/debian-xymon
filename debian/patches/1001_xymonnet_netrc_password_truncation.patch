From b4c4775dcba979b2637f63e0f9c1ac904a71be23 Mon Sep 17 00:00:00 2001
From: soundgoof <soundgoof@gmail.com>
Date: Mon, 6 Jul 2026 23:37:50 +0200
Subject: [PATCH] lib/url.c: fix off-by-one truncating the last char of .netrc
 passwords
Origin: https://github.com/axians/xymon/commit/b4c4775dcba979b2637f63e0f9c1ac904a71be23
Last-Update: 2026-07-31

load_netrc() correctly allocated login_len+1 bytes for "login:password",
but passed login_len (one byte short) as the size to snprintf(), which
silently dropped the password's last character on every load. Introduced
in 484edeb26 during the 2019 CVE-2019-1345x sprintf->snprintf hardening
pass; still present on all upstream branches.
---
 lib/url.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/lib/url.c b/lib/url.c
index 2518c44ce..9ae67ea2a 100644
--- a/lib/url.c
+++ b/lib/url.c
@@ -223,7 +223,7 @@ static void load_netrc(void)
 
 					item->host = host;
 					item->auth = (char *) malloc(login_len + 1);
-					snprintf(item->auth, login_len, "%s:%s", login, password);
+					snprintf(item->auth, login_len + 1, "%s:%s", login, password);
 					item->next = loginhead;
 					loginhead = item;
 					host = login = password = NULL;
